Task 5: Tap the Add to Cart button using coordinates only:-


import java.util.HashMap;
import java.util.Map;
import io.appium.java_client.android.AndroidDriver;

public class CoordinateTapTest {
    public static void tapAddToCart(AndroidDriver driver) {

        // Example coordinates; adjust to your screen.
        Map<String, Object> params = new HashMap<>();
        params.put("x", 540);
        params.put("y", 1600);

        driver.executeScript(
            "mobile: clickGesture", params);

        System.out.println("Add to Cart coordinate tap performed.");
    }
}
